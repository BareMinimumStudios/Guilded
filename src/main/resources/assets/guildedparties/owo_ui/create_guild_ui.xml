<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical">
            <children>
                <flow-layout direction="vertical" id="main">
                    <children>
                        <flow-layout direction="horizontal">
                            <children>
                                <button id="back">
                                    <text translate="true">gui.guildedparties.back</text>

                                    <positioning type="layout">0,0</positioning>

                                    <sizing>
                                        <vertical method="content">1</vertical>
                                        <horizontal method="fill">10</horizontal>
                                    </sizing>

                                    <margins>
                                        <left>1</left>
                                        <bottom>1</bottom>
                                    </margins>
                                </button>
                            </children>

                            <sizing>
                                <vertical method="content">1</vertical>
                                <horizontal method="fill">100</horizontal>
                            </sizing>

                            <horizontal-alignment>left</horizontal-alignment>
                            <vertical-alignment>center</vertical-alignment>

                            <positioning type="layout">1,1</positioning>
                        </flow-layout>

                        <text-box id="guild-name">
                            <text/>

                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="content">1</vertical>
                            </sizing>
                        </text-box>

                        <text-box id="leader-rank-name">
                            <text/>

                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="content">1</vertical>
                            </sizing>

                            <margins>
                                <bottom>1</bottom>
                                <top>1</top>
                            </margins>
                        </text-box>

                        <text-area id="description">
                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="content">1</vertical>
                            </sizing>

                            <margins>
                                <all>1</all>
                            </margins>

                            <max-lines>10</max-lines>
                        </text-area>

                        <button id="confirm-button">
                            <text translate="true">gui.guildedparties.confirm</text>

                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="content">1</vertical>
                            </sizing>

                            <margins>
                                <all>2</all>
                            </margins>
                        </button>
                    </children>

                    <padding>
                        <all>5</all>
                    </padding>

                    <sizing>
                        <vertical method="content">1</vertical>
                        <horizontal method="fill">60</horizontal>
                    </sizing>

                    <vertical-alignment>center</vertical-alignment>
                    <horizontal-alignment>center</horizontal-alignment>

                    <positioning type="relative">50,50</positioning>
                </flow-layout>
            </children>

            <surface>
                <vanilla-translucent/>
            </surface>

            <sizing>
                <vertical method="fill">100</vertical>
                <horizontal method="fill">100</horizontal>
            </sizing>
        </flow-layout>
    </components>
</owo-ui>

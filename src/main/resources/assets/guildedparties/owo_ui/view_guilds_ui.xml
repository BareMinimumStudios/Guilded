<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <components>
        <flow-layout direction="horizontal">
            <children>
                <button id="back_button">
                    <text translate="true">gui.guildedparties.back</text>

                    <sizing>
                        <vertical method="content">0</vertical>
                        <horizontal method="content">0</horizontal>
                    </sizing>

                    <positioning type="relative">2,2</positioning>
                </button>

                <flow-layout direction="horizontal" id="main_layout">
                    <children>
                        <scroll direction="horizontal">
                            <flow-layout direction="horizontal" id="guild_list">
                                <children/>

                                <sizing>
                                    <vertical method="fill">100</vertical>
                                    <horizontal method="fill">100</horizontal>
                                </sizing>

                                <padding>
                                    <all>2</all>
                                    <bottom>2</bottom>
                                </padding>

                                <surface>
                                    <panel dark="false"/>
                                </surface>
                            </flow-layout>

                            <sizing>
                                <vertical method="fill">100</vertical>
                                <horizontal method="fill">100</horizontal>
                            </sizing>
                        </scroll>
                    </children>

                    <surface>
                        <outline>black</outline>
                    </surface>

                    <sizing>
                        <vertical method="fill">50</vertical>
                        <horizontal method="fill">50</horizontal>
                    </sizing>

                    <positioning type="relative">50,50</positioning>
                </flow-layout>
            </children>

            <surface>
                <vanilla-translucent/>
            </surface>

            <sizing>
                <horizontal method="fill">100</horizontal>
                <vertical method="fill">100</vertical>
            </sizing>
        </flow-layout>
    </components>

    <templates>
        <template name="guild">
            <flow-layout direction="vertical">
                <children>
                    <flow-layout direction="vertical" id="guild_details">
                        <children>
                            <label>
                                <text>{{guild_name}}</text>

                                <color>black</color>

                                <positioning type="relative">0,0</positioning>

                                <sizing>
                                    <vertical method="fill">20</vertical>
                                    <horizontal method="content">1</horizontal>
                                </sizing>

                                <horizontal-text-alignment>center</horizontal-text-alignment>
                            </label>

                            <label>
                                <text>Leader: {{leader_name}}</text>

                                <color>black</color>

                                <positioning type="relative">0,50</positioning>

                                <sizing>
                                    <vertical method="fill">20</vertical>
                                    <horizontal method="content">1</horizontal>
                                </sizing>

                                <horizontal-text-alignment>center</horizontal-text-alignment>
                            </label>

                            <label>
                                <text>Members: {{members}}</text>

                                <color>black</color>

                                <positioning type="relative">0,100</positioning>

                                <sizing>
                                    <vertical method="fill">20</vertical>
                                    <horizontal method="content">1</horizontal>
                                </sizing>

                                <horizontal-text-alignment>center</horizontal-text-alignment>
                            </label>
                        </children>

                        <sizing>
                            <vertical method="fill">30</vertical>
                            <horizontal method="fill">100</horizontal>
                        </sizing>

                        <padding>
                            <all>2</all>
                        </padding>

                        <margins>
                            <bottom>2</bottom>
                        </margins>
                    </flow-layout>

                    <flow-layout direction="vertical" id="guild_description">
                        <children>
                            <scroll direction="vertical">
                                <label>
                                    <text>{{description}}</text>

                                    <color>black</color>

                                    <sizing>
                                        <vertical method="content">1</vertical>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>

                                    <vertical-text-alignment>center</vertical-text-alignment>
                                    <horizontal-text-alignment>center</horizontal-text-alignment>
                                </label>

                                <sizing>
                                    <horizontal method="fill">100</horizontal>
                                    <vertical method="fill">100</vertical>
                                </sizing>
                            </scroll>
                        </children>

                        <surface>
                            <flat>gray</flat>
                            <outline>black</outline>
                        </surface>

                        <sizing>
                            <vertical method="fill">50</vertical>
                            <horizontal method="fill">100</horizontal>
                        </sizing>
                    </flow-layout>


                    <button>
                        <text translate="true">gui.guildedparties.join</text>

                        <sizing>
                            <vertical method="fill">10</vertical>
                            <horizontal method="fill">100</horizontal>
                        </sizing>

                        <positioning type="relative">0,100</positioning>
                    </button>
                </children>

                <surface>
                    <flat>white</flat>
                    <outline>black</outline>
                </surface>

                <padding>
                    <all>2</all>
                </padding>

                <sizing>
                    <vertical method="fill">100</vertical>
                    <horizontal method="fill">50</horizontal>
                </sizing>

                <allow-overflow>false</allow-overflow>
            </flow-layout>
        </template>
    </templates>
</owo-ui>

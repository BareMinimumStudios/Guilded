<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <templates>
        <template name="guild-description">
            <flow-layout direction="vertical" id="guild_description">
                <children>
                    <flow-layout direction="vertical">
                        <children>
                            <label>
                                <text>Guild: {{guild-name}}</text>

                                <vertical-text-alignment>top</vertical-text-alignment>
                                <horizontal-text-alignment>left</horizontal-text-alignment>

                                <color>black</color>

                                <positioning type="layout">0,0</positioning>

                                <margins>
                                    <bottom>4</bottom>
                                </margins>
                            </label>

                            <label>
                                <text>Rank: {{your-rank}}</text>

                                <color>black</color>

                                <vertical-text-alignment>top</vertical-text-alignment>
                                <horizontal-text-alignment>left</horizontal-text-alignment>

                                <positioning type="layout">0,10</positioning>

                                <margins>
                                    <bottom>4</bottom>
                                </margins>
                            </label>

                            <scroll direction="vertical" id="description-container">
                                <label>
                                    <text>Description: {{description}}</text>

                                    <color>black</color>

                                    <vertical-text-alignment>center</vertical-text-alignment>
                                    <horizontal-text-alignment>left</horizontal-text-alignment>

                                    <positioning type="relative">0,0</positioning>

                                    <sizing>
                                        <horizontal method="fill">100</horizontal>
                                        <vertical method="content">1</vertical>
                                    </sizing>

                                    <max-width>200</max-width>
                                </label>

                                <surface>
                                    <flat>gray</flat>
                                    <outline>black</outline>
                                </surface>

                                <positioning type="layout">0,0</positioning>

                                <padding>
                                    <all>2</all>
                                </padding>

                                <margins>
                                    <bottom>6</bottom>
                                </margins>
                            </scroll>
                        </children>

                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="content">1</vertical>
                        </sizing>

                        <horizontal-alignment>center</horizontal-alignment>
                        <vertical-alignment>top</vertical-alignment>
                    </flow-layout>

                    <flow-layout direction="vertical">
                        <children>
                            <button id="settings-button">
                                <text translate="true">gui.guildedparties.settings_button</text>

                                <vertical-alignment>bottom</vertical-alignment>
                                <horizontal-alignment>center</horizontal-alignment>

                                <sizing>
                                    <horizontal method="fill">100</horizontal>
                                    <vertical method="content">1</vertical>
                                </sizing>

                                <positioning type="layout">0,0</positioning>

                                <margins>
                                    <bottom>2</bottom>
                                </margins>
                            </button>

                            <button id="management-button">
                                <text translate="true">gui.guildedparties.management_button</text>

                                <vertical-alignment>bottom</vertical-alignment>
                                <horizontal-alignment>center</horizontal-alignment>

                                <sizing>
                                    <horizontal method="fill">100</horizontal>
                                    <vertical method="content">1</vertical>
                                </sizing>

                                <positioning type="layout">0,0</positioning>

                                <margins>
                                    <bottom>2</bottom>
                                </margins>
                            </button>

                            <button id="leave-button">
                                <text translate="true">gui.guildedparties.leave_button</text>

                                <vertical-alignment>bottom</vertical-alignment>
                                <horizontal-alignment>center</horizontal-alignment>

                                <sizing>
                                    <horizontal method="fill">100</horizontal>
                                    <vertical method="content">1</vertical>
                                </sizing>

                                <positioning type="layout">0,0</positioning>

                                <margins>
                                    <bottom>2</bottom>
                                </margins>
                            </button>

                            <button id="invite-button">
                                <text translate="true">gui.guildedparties.invite_button</text>

                                <vertical-alignment>bottom</vertical-alignment>
                                <horizontal-alignment>center</horizontal-alignment>

                                <sizing>
                                    <horizontal method="fill">100</horizontal>
                                    <vertical method="content">1</vertical>
                                </sizing>

                                <positioning type="layout">0,0</positioning>
                            </button>
                        </children>

                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="content">1</vertical>
                        </sizing>

                        <vertical-alignment>bottom</vertical-alignment>
                    </flow-layout>
                </children>

                <positioning type="layout">0,0</positioning>

                <padding>
                    <all>5</all>
                </padding>

                <margins>
                    <right>1</right>
                </margins>

                <sizing>
                    <horizontal method="fill">40</horizontal>
                    <vertical method="content">1</vertical>
                </sizing>

                <vertical-alignment>bottom</vertical-alignment>
                <horizontal-alignment>left</horizontal-alignment>
            </flow-layout>
        </template>

        <template name="guildmate-element">
            <flow-layout direction="horizontal">
                <children>
                    <flow-layout direction="vertical">
                        <children>
                            <label>
                                <text>Name: {{guildmate-name}}</text>

                                <horizontal-text-alignment>left</horizontal-text-alignment>
                                <vertical-text-alignment>center</vertical-text-alignment>

                                <color>black</color>

                                <sizing>
                                    <vertical method="content">1</vertical>
                                    <horizontal method="content">1</horizontal>
                                </sizing>

                                <positioning type="layout">0,0</positioning>
                            </label>

                            <label>
                                <text>Rank: {{guildmate-rank}}</text>

                                <horizontal-text-alignment>left</horizontal-text-alignment>
                                <vertical-text-alignment>center</vertical-text-alignment>

                                <color>black</color>

                                <sizing>
                                    <vertical method="content">1</vertical>
                                    <horizontal method="content">1</horizontal>
                                </sizing>
                                <positioning type="layout">0,0</positioning>
                            </label>
                        </children>

                        <positioning type="layout">1,1</positioning>

                        <sizing>
                            <horizontal method="content">50</horizontal>
                            <vertical method="content">1</vertical>
                        </sizing>

                        <horizontal-alignment>left</horizontal-alignment>
                    </flow-layout>

                    <button id="view-guildmate-button">
                        <text translate="true">gui.guildedparties.view_button</text>

                        <padding>
                            <all>5</all>
                            <left>5</left>
                            <right>5</right>
                        </padding>

                        <vertical-alignment>center</vertical-alignment>
                        <horizontal-alignment>right</horizontal-alignment>

                        <sizing>
                            <horizontal method="content">1</horizontal>
                            <vertical method="content">1</vertical>
                        </sizing>

                        <positioning type="layout">1,1</positioning>

                    </button>
                </children>

                <padding>
                    <all>2</all>
                </padding>

                <sizing>
                    <horizontal method="content">1</horizontal>
                    <vertical method="content">1</vertical>
                </sizing>

                <surface>
                    <outline>black</outline>
                </surface>
            </flow-layout>
        </template>
    </templates>
</owo-ui>    
<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical">
            <children>
                <flow-layout direction="vertical">
                    <children>
                        <flow-layout direction="horizontal">
                            <children>
                                <button id="view-guilds-button">
                                    <padding>
                                        <all>2</all>
                                    </padding>

                                    <text translate="true">gui.guildedparties.view_guilds_button</text>

                                    <margins>
                                        <right>5</right>
                                    </margins>

                                    <positioning type="layout">1,1</positioning>

                                    <horizontal-alignment>left</horizontal-alignment>
                                    <vertical-alignment>top</vertical-alignment>

                                    <sizing>
                                        <vertical method="content">1</vertical>
                                        <horizontal method="content">1</horizontal>
                                    </sizing>
                                </button>
                                <button id="create-guild-button">
                                    <padding>
                                        <all>2</all>
                                    </padding>
                                    <text translate="true">gui.guildedparties.create_guild_button</text>

                                    <positioning type="layout">1,1</positioning>

                                    <horizontal-alignment>right</horizontal-alignment>
                                    <vertical-alignment>top</vertical-alignment>

                                    <sizing>
                                        <vertical method="content">1</vertical>
                                        <horizontal method="content">1</horizontal>
                                    </sizing>
                                </button>
                            </children>
                        </flow-layout>
                        <button id="quick-join">
                            <text translate="true">gui.guildedparties.quick_join</text>

                            <positioning type="layout">1,1</positioning>

                            <sizing>
                                <vertical method="content">1</vertical>
                                <horizontal method="content">35</horizontal>
                            </sizing>

                            <vertical-alignment>bottom</vertical-alignment>
                            <horizontal-alignment>center</horizontal-alignment>

                            <margins>
                                <top>2</top>
                            </margins>
                        </button>
                    </children>

                    <sizing>
                        <vertical method="content">1</vertical>
                        <horizontal method="content">1</horizontal>
                    </sizing>

                    <surface>
                        <panel dark="false"/>
                    </surface>

                    <padding>
                        <all>4</all>
                    </padding>

                    <vertical-alignment>center</vertical-alignment>
                    <horizontal-alignment>center</horizontal-alignment>
                </flow-layout>
            </children>

            <vertical-alignment>center</vertical-alignment>
            <horizontal-alignment>center</horizontal-alignment>

            <surface>
                <vanilla-translucent/>
            </surface>

            <sizing>
                <vertical method="fill">100</vertical>
                <horizontal method="fill">100</horizontal>
            </sizing>
        </flow-layout>
    </components>
</owo-ui>

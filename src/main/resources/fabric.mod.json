{
	"schemaVersion": 1,
	"id": "guildedparties",
	"version": "${version}",
	"name": "Guilded",
	"description": "A faction mod for the user and developer",
	"authors": [
		"Keno"
	],
	"contact": {
		"sources": "https://github.com/BareMinimumStudios/Guilded"
	},
	"license": "Assets ARR, Code MIT",
	"icon": "assets/guildedparties/guilded.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "keno.guildedparties.GuildedParties"
		],
		"cardinal-components": [
			"keno.guildedparties.api.data.GPComponents"
		],
		"server": [
			"keno.guildedparties.api.server.GPServer"
		],
		"client": [
			"keno.guildedparties.api.client.GPClient"
		],
		"guilded": [
			"keno.guildedparties.api.compat.GPGuildedCompat"
		]
	},
	"custom": {
		"cardinal-components": [
			"guildedparties:invite",
			"guildedparties:member",
			"guildedparties:gc_toggle"
		]
	},
	"mixins": [
		"guildedparties.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"owo": "*"
	}
}